# Snowflake connection
# Account identifier should NOT include .snowflakecomputing.com.
# Example: orgname-accountname or the identifier shown by Snowflake.

SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password

# Existing Snowflake warehouse. Leave blank only if your role/session
# already has a usable warehouse.
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

SNOWFLAKE_DATABASE=PHISHGRAPH_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Optional. Leave blank to use your user's default role.
SNOWFLAKE_ROLE=

# Cortex text model. Check availability in your account with:
# SHOW CORTEX BASE MODELS;
CORTEX_MODEL=snowflake-arctic
